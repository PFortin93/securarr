#!/usr/bin/env bash
#
# Manage the SOPS-encrypted secrets this stack needs.
#
#   ./scripts/secrets decrypt      *.enc.env -> *.env   (before compose up)
#   ./scripts/secrets encrypt      *.env -> *.enc.env   (after editing)
#   ./scripts/secrets edit vpn     edit one file, never written in the clear
#   ./scripts/secrets check        confirm every encrypted file still opens
#   ./scripts/secrets clean        shred the decrypted copies
#
# Only the .enc.env files are committed. The plaintext .env files are
# gitignored and exist purely so Compose can read them at up time.

set -euo pipefail

cd "$(dirname "$0")/.."

SECRETS=(vpn arr-keys caddy cloudflared)

die() { printf 'error: %s\n' "$1" >&2; exit 1; }

command -v sops >/dev/null || die "sops not found. brew install sops age"

case "${1:-}" in
  decrypt)
    for s in "${SECRETS[@]}"; do
      sops --decrypt "secrets/$s.enc.env" > "secrets/$s.env"
      chmod 600 "secrets/$s.env"
      printf 'decrypted secrets/%s.env\n' "$s"
    done
    ;;

  encrypt)
    for s in "${SECRETS[@]}"; do
      [ -f "secrets/$s.env" ] || { printf 'skipping %s (no plaintext)\n' "$s"; continue; }
      sops --encrypt "secrets/$s.env" > "secrets/$s.enc.env"
      printf 'encrypted secrets/%s.enc.env\n' "$s"
    done
    ;;

  edit)
    [ -n "${2:-}" ] || die "which one? $(printf '%s ' "${SECRETS[@]}")"
    sops "secrets/$2.enc.env"
    ;;

  check)
    failed=0
    for s in "${SECRETS[@]}"; do
      if sops --decrypt "secrets/$s.enc.env" >/dev/null 2>&1; then
        printf 'ok    secrets/%s.enc.env\n' "$s"
      else
        printf 'FAIL  secrets/%s.enc.env\n' "$s"; failed=1
      fi
    done
    exit $failed
    ;;

  clean)
    # Named explicitly, not globbed — secrets/*.env would match the
    # .enc.env files too and delete the only copies that matter.
    for s in "${SECRETS[@]}"; do
      rm -f "secrets/$s.env"
    done
    echo "plaintext secrets removed"
    ;;

  *)
    sed -n '3,15p' "$0" | sed 's/^# \{0,1\}//'
    exit 1
    ;;
esac
