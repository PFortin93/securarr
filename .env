# Non-secret configuration. Safe to commit.
# Anything sensitive lives in secrets/*.enc.env instead.

# ─── Host ────────────────────────────────────────────────────────────
# Hardware profile, read ONLY by the Plex stack — it is the host that
# owns the GPU. The arr stack includes no profile and is entirely
# hardware-agnostic. See hosts/ for the available profiles.
HOST_PROFILE=hosts/nvidia.yaml

# Only read by hosts/intel-quicksync.yaml. The host's `render` group gid,
# which varies by distribution — check with `getent group render` on the
# target machine. Wrong value means silent CPU transcoding.
RENDER_GID=993

# ─── Identity ────────────────────────────────────────────────────────
PUID=1000
PGID=1000

# One timezone for every container.
TZ=Etc/UTC

# ─── Paths ───────────────────────────────────────────────────────────
CONFIG_DIRECTORY=/var/lib/securarr/config
MEDIA_DIRECTORY=/mnt/media
SCRATCH_DIRECTORY=/mnt/scratch

# ─── Published ports ─────────────────────────────────────────────────
# Interface the individual apps' direct ports bind to.
#   127.0.0.1  loopback only — apps reachable ONLY via the proxy (default)
#   <LAN IP>   LAN only
#   0.0.0.0    every interface
#
# With the default, every app is reachable only through Caddy (or the
# tunnel behind it) — which is the point of running a proxy at all.
# Loosen this only while bootstrapping, then lock it back down.
BIND_ADDRESS=127.0.0.1

# Interface Caddy binds 80/443 to. This one must stay on the LAN even
# with BIND_ADDRESS locked down, or nothing can reach the proxy either —
# they are separate variables for exactly that reason.
PROXY_BIND_ADDRESS=0.0.0.0

# Where Plex lives. If you run the single-host layout, this is the same
# machine and you can use host.docker.internal; with the two-host layout
# it is the Plex VM's address. Seerr, Tautulli and Caddy reach it here.
PLEX_HOST=192.168.2.10

# ─── Ingress ─────────────────────────────────────────────────────────
# LAN name: <app>.${DOMAIN}, resolved by your home DNS to the arr host.
DOMAIN=media.example.com
# Remote name: <app>.${REMOTE_DOMAIN}, existing only where a proxied
# CNAME to the tunnel + an Access policy have been created in Cloudflare.
REMOTE_DOMAIN=example.com

# Where Let's Encrypt sends certificate expiry warnings. This file is
# committed, so keep it a placeholder in git — point your deployment at
# an address you read.
ACME_EMAIL=you@example.com

# ─── VPN ─────────────────────────────────────────────────────────────
# Any provider gluetun supports: https://github.com/qdm12/gluetun-wiki
VPN_SERVICE_PROVIDER=mullvad
